---
import { helpQuote, helpAuthor } from "@data/quotes";
---

<div class="help-bg w-100 d-flex flex-column justify-content-center align-items-center" id="help-bg">
  <p class="help-bg-quote px-3 text-center">
    <q>{helpQuote}</q>
  </p>
  <p class="help-bg-author text-center">
    {helpAuthor}
  </p>
</div>