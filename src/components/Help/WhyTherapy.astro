---
import { getEntry, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

const helpLanding: CollectionEntry<"help"> | undefined = await getEntry("help", "why_therapy")
if (!helpLanding) {
  throw new Error('Could not find help\'s "why_therapy" text')
}

const { Content } = await render(helpLanding)

const title: string = "Why Attending Therapy?"
---

<div class="container-fluid col-sm-10 col-md-9 min-vh-100 d-flex flex-column justify-content-center py-5">
  <h2 class="my-5 mt-2 text-center">{title}</h2>
  <div class="container-fluid">
    <Content />
  </div>
</div>