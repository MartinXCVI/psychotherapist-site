---
import { getEntry, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

const testimonialsLanding: CollectionEntry<"testimonials"> | undefined = await getEntry("testimonials", "first_review")
if (!testimonialsLanding) {
  throw new Error('Could not find testimonials\' "first_review" text')
}

const { Content } = await render(testimonialsLanding)

import { reviews } from "src/data/reviews"
const { firstReviewer } = reviews
---

<article
  class="container-fluid justify-content-center align-items-center row px-sm-2 py-4 p-xl-4"
  id="first-rev"
  aria-label={`${firstReviewer.fullName}'s testimonial`}
>
  <div class="intro-article col-sm-10 col-md-8 col-lg-9 col-xl-8">
    <Content />
  </div>
  <div class="col-sm-10 col-md-8 col-lg-6 col-xl-3">
    <figure class="figure">
      <img
        src="/images/rev-img-1.jpg"
        class="figure-img img-fluid rounded"
        alt={`${firstReviewer.fullName} smiling`}
        title={firstReviewer.fullName}
        aria-labelledby="first-reviewer-caption"
      >
      <figcaption class="text-center" id="first-reviewer-caption">
        <span class="rev-name">
          {firstReviewer.fullName}
        </span> <br>
        <span class="rev-job">
          {firstReviewer.profession}
        </span>
      </figcaption>
    </figure>
  </div>
</article>