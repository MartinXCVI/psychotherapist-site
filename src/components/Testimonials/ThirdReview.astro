---
import { getEntry, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

const testimonialsLanding: CollectionEntry<"testimonials"> | undefined = await getEntry("testimonials", "third_review")
if (!testimonialsLanding) {
  throw new Error('Could not find testimonials\' "third_review" text')
}

const { Content } = await render(testimonialsLanding)

import { reviews } from "src/data/reviews"
const { thirdReviewer } = reviews
---

<div class="container-fluid justify-content-center align-items-center row px-sm-2 py-4 p-xl-4" id="third-rev">
  <div class="intro-article col-sm-10 col-md-8 col-lg-9 col-xl-8">
    <Content />
  </div>
  <div class="col-sm-10 col-md-8 col-lg-6 col-xl-3">
    <figure class="figure">
      <img
        src="src/assets/images/rev-img-3.jpg"
        class="figure-img img-fluid rounded"
        alt="..."
      >
      <figcaption class="text-center">
        <span class="rev-name">
          {thirdReviewer.fullName}
        </span> <br>
        <span class="rev-job">
          {thirdReviewer.profession}
        </span>
      </figcaption>
    </figure>
  </div>
</div>