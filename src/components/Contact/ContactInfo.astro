---
import { getEntry, render } from 'astro:content'

const contactLanding = await getEntry("contact", "contact_info")
if (!contactLanding) {
  throw new Error('Could not find contact\'s "contact_info" text')
}

const { Content } = await render(contactLanding)

import { myInfo } from "src/data/myInfo"
const { email, phone, onlineTreating, officeAddress } = myInfo

const title: string = "Virtually or In-Person"
---

<h2 class="w-100 text-center mt-4">{title}</h2>
<div class="container-fluid d-flex flex-column flex-lg-row my-4">
  <!--- First block --->
  <div class="container col-12 col-lg-6 px-lg-4 my-3">
    <ul class="contact-info-list">
      <li>
        <small><i class="fa-solid fa-envelope"></i> Email</small><br>
        <p>{email}</p>
      </li>
      <li>
        <small><i class="fa-solid fa-phone"></i> Phone</small><br>
        <p>{phone}</p>
      </li>
      <li>
        <small><i class="fa-solid fa-globe"></i> Online Treating</small><br>
        <p>{onlineTreating}</p>
      </li>
      <li>
        <small><i class="fa-solid fa-couch"></i> In Person</small><br>
        <p>{officeAddress}</p>
      </li>
    </ul>
  </div>
  <!--- Second block --->
  <div class="container col-12 col-lg-6 px-lg-4 my-3">
    <Content />
  </div>
</div>