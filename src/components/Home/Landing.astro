---
import { getEntry, render } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

const homeLanding: CollectionEntry<"home"> | undefined = await getEntry("home", "landing")
if (!homeLanding) {
  throw new Error('Could not find home\'s "landing" text')
}

const { Content } = await render(homeLanding)

import { myInfo } from "../../data/myInfo"
const { fullName, myProf } = myInfo
---

<section class="container-fluid justify-content-center row px-sm-2 py-4 p-xl-4 py-xl-5">
  <div class="col-sm-10 col-md-7 col-lg-6 col-xl-6">
    <figure class="figure">
      <img
        src="src/assets/images/profile.jpg"
        class="figure-img img-fluid rounded"
        alt="..."
      >
      <figcaption class="figure-caption text-center fs-5">
        Certified {myProf}<br> & Life Coach
      </figcaption>
    </figure>
  </div>
  <div class="intro-article col-sm-10 col-md-9 col-lg-8 col-xl-6">
    <p class="my-0">Be more than welcome</p>
    <h2 class="my-5 mt-2">My name is {fullName}, and I am a Certified {myProf}.</h2>
    <article>
      <Content />
    </article>
    <!--- * BUTTONS * --->
    <div class="landing-btns d-flex flex-column flex-sm-row justify-content-evenly pt-4">
      <a
        class="landing-btn btn contact-btn mb-3 mb-sm-0"
        href="/contact"
      >
        Consultation
      </a>
      <a
        class="landing-btn btn about-btn"
        href="/about"
      >
        More about me
      </a>
    </div>
  </div>
</section>